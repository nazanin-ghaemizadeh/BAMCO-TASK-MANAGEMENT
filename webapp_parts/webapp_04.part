llowups(false);document.getElementById('sendFollowups').onclick=()=>runFollowups(true);document.getElementById('clearFollowDates').onclick=()=>{document.getElementById('followFrom').value='';document.getElementById('followTo').value=''};document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>document.getElementById(b.dataset.close).close());document.getElementById('calPrev').onclick=()=>{if(--state.cal.jm<1){state.cal.jm=12;state.cal.jy--}renderCalendar()};document.getElementById('calNext').onclick=()=>{if(++state.cal.jm>12){state.cal.jm=1;state.cal.jy++}renderCalendar()};document.getElementById('calYear').onchange=e=>{state.cal.jy=Number(e.target.value);renderCalendar()};document.getElementById('calMonth').onchange=e=>{state.cal.jm=Number(e.target.value);renderCalendar()};document.getElementById('calendarClear').onclick=()=>{if(state.calendarTarget)document.getElementById(state.calendarTarget).value='';document.getElementById('calendarDialog').close();renderDashboard()};['peopleTable','sendTable','followTable'].forEach(setupHeaderFilters);document.addEventListener('click',e=>{if(!e.target.closest('#filterPopup')&&!e.target.closest('th[data-col]'))document.getElementById('filterPopup').classList.add('hidden')});window.addEventListener('resize',()=>{if(document.getElementById('view-dashboard').classList.contains('active-view'))renderDashboard()})}
async function init(){wire();renderTemplates();refreshDashFilterOptions();renderPeople();renderSend();await loadConfig();await refreshStickerPacks();refreshStickerContext()}
document.readyState==='loading'?document.addEventListener('DOMContentLoaded',init):init();
})();