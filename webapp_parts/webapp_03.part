()}
function renderPerformanceChart(){const owner=document.getElementById('dashOwner').value,priority=document.getElementById('dashPriority').value,known=state.dashboardKnownOwners||[],from=jalaliTuple(document.getElementById('perfFrom').value),to=jalaliTuple(document.getElementById('perfTo').value);let rows=[];for(const r of state.dashboard.archive||[]){const co=canonicalOwnerName(r.owner,known);if(owner!=='همه'&&norm(co)!==norm(owner))continue;if(priority!=='همه'&&norm(r.priority)!==norm(priority))continue;let end=r.archive_filter_end_jalali||r.archive_end_jalali;const phys=r.row_jalali_dates_in_order||[];if(!end)end=phys.length>=2?phys[1]:phys[0];if(from||to){if(!end)continue;if(from&&cmpTuple(end,from)<0)continue;if(to&&cmpTuple(end,to)>0)continue}rows.push(r)}const g={};for(const r of rows){const o=canonicalOwnerName(r.owner,known);if(o==='—')continue;g[o]??={delay:0,accel:0};const d=Number(r.archive_delta);if(Number.isFinite(d)){if(d>0)g[o].accel+=d;else if(d<0)g[o].delay+=Math.abs(d)}}const perf=Object.entries(g).filter(([,v])=>v.delay||v.accel).map(([o,v])=>[o,v.delay,v.accel]).sort((a,b)=>(b[1]+b[2])-(a[1]+a[2])||b[1]-a[1]||b[2]-a[2]||a[0].localeCompare(b[0],'fa'));drawPerformance(document.getElementById('performanceChart'),perf,`رکورد بر اساس تاریخ پایان: ${fa(rows.length)}`)}

async function refreshStickerPacks(){try{const d=await bridge('/stickers/packs',null,'GET'),s=document.getElementById('stickerPack'),old=s.value||'نسخه اصلی';s.innerHTML=(d.packs||['نسخه اصلی']).map(x=>`<option>${esc(x)}</option>`).join('');s.value=(d.packs||[]).includes(old)?old:'نسخه اصلی'}catch{const s=document.getElementById('stickerPack');s.innerHTML='<option>نسخه اصلی</option>'}}
function fillStickerControls(){document.getElementById('stickerState').innerHTML=['state1','state2','state3','state4','state5'].map(k=>`<option value="${k}">${STATE_META[k].label}</option>`).join('')}
async function refreshStickerContext(){await refreshStickerPacks();const key=document.getElementById('stickerState').value||'state1',gender=document.querySelector('input[name=stickerGender]:checked').value;try{const d=await bridge('/stickers/preview',{key,gender});document.getElementById('stickerPreview').src=d.data_url}catch{const prefix=STATE_META[key].sticker,suffix=gender==='خانم'?'female':'male';document.getElementById('stickerPreview').src=A()[`${prefix}_${suffix}`]||''}}
async function activatePack(){const title=document.getElementById('stickerPack').value;try{busy(true,'در حال فعال‌سازی نسخه استیکر…');await bridge('/stickers/activate',{title});await refreshStickerContext();await alertBox('نسخه استیکر',`مجموعه استیکر «${title}» فعال شد.`)}catch(e){await alertBox('نسخه استیکر',e.message)}finally{busy(false)}}
async function restorePack(){if(!await alertBox('بازگردانی استیکرها','همه ده استیکر به نسخه اصلی بازگردند؟',{confirm:true}))return;try{await bridge('/stickers/restore',{});document.getElementById('stickerPack').value='نسخه اصلی';await refreshStickerContext();await alertBox('بازگردانی استیکرها','نسخه اصلی همه استیکرها فعال شد.')}catch(e){await alertBox('بازگردانی استیکرها',e.message)}}
function buildPackMatrix(){const states=['state1','state2','state3','state4','state5'],m=document.getElementById('packMatrix');m.innerHTML='<div class="pack-head">نسخه</div>'+states.map(k=>`<div class="pack-head">${STATE_META[k].label}</div>`).join('');for(const gender of ['خانم','آقا']){m.insertAdjacentHTML('beforeend',`<div class="pack-head">نسخه ${gender}</div>`);for(const key of states){const id=`pack_${key}_${gender==='خانم'?'female':'male'}`;m.insertAdjacentHTML('beforeend',`<div class="pack-cell"><input id="${id}" type="file" accept="image/png,image/jpeg,image/webp"></div>`)}}}
async function fileToData(file){return await new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=rej;r.readAsDataURL(file)})}
async function savePack(ev){ev.preventDefault();const title=norm(document.getElementById('packName').value),images={},missing=[];for(const gender of ['خانم','آقا'])for(const key of ['state1','state2','state3','state4','state5']){const id=`pack_${key}_${gender==='خانم'?'female':'male'}`,file=document.getElementById(id).files[0];if(!file)missing.push(`${STATE_META[key].label} ـ ${gender}`);else images[`${key}|${gender}`]=await fileToData(file)}if(!title){await alertBox('نام نسخه','برای نسخه جدید یک نام وارد کنید.');return}if(missing.length){await alertBox('تصاویر ناقص','هر ده تصویر نسخه خانم و آقا باید بارگذاری شوند.');return}busy(true,'در حال ذخیره نسخه استیکر…');try{await bridge('/stickers/upload-pack',{title,images});document.getElementById('packDialog').close();await refreshStickerPacks();document.getElementById('stickerPack').value=title;await refreshStickerContext();await alertBox('نسخه استیکر',`مجموعه استیکر «${title}» فعال شد.`)}catch(e){await alertBox('ذخیره نسخه',e.message)}finally{busy(false)}}

function renderFollowups(){const body=document.querySelector('#followTable tbody');body.innerHTML='';state.followups.forEach((r,i)=>{const response=r.found?(r.responded?'بله':'خیر'):'ایمیلی یافت نشد',last=r.found?r.sent_display||'':'—',subject=r.found?r.subject||'':'—',p=r.person||{};const tr=document.createElement('tr');tr.innerHTML=`<td class="center-cell">${state.followSelected.has(i)?'☑':'☐'}</td><td class="center-cell">${response}</td><td class="center-cell">${esc(last)}</td><td>${esc(subject)}</td><td class="ltr">${esc(p.email||'')}</td><td>${esc(p.name||'')}</td>`;tr.onclick=()=>{if(!r.found)return;state.followSelected.has(i)?state.followSelected.delete(i):state.followSelected.add(i);renderFollowups()};body.appendChild(tr)});applyTableFilters('followTable')}
async function inspectFollowups(){const from=document.getElementById('followFrom').value.trim(),to=document.getElementById('followTo').value.trim();if(!from||!to){await alertBox('بازه زمانی','ابتدا بازه زمانی را انتخاب کنید.');return}busy(true,'در حال جست‌وجوی همه ایمیل‌ها و پاسخ‌های بازه انتخاب‌شده…');try{const d=await bridge('/followups/inspect',{people:activePeople(),date_from:from,date_to:to});state.followups=d.rows||[];state.followSelected.clear();renderFollowups();const found=state.followups.filter(r=>r.found).length,responded=state.followups.filter(r=>r.responded).length;await alertBox('بررسی پاسخ‌ها',`پایان بررسی: ${fa(found)} ایمیل پیدا شد و ${fa(responded)} پاسخ دریافت شده است.`)}catch(e){await alertBox('بررسی پاسخ‌ها',e.message)}finally{busy(false)}}
function selectUnanswered(){state.followSelected=new Set(state.followups.map((r,i)=>r.found&&!r.responded?i:null).filter(i=>i!==null));renderFollowups()}
async function runFollowups(automatic){const rows=[...state.followSelected].sort((a,b)=>a-b).map(i=>state.followups[i]).filter(Boolean);if(!rows.length){await alertBox('انتخاب فرد','حداقل یک فرد دارای ایمیل قبلی را انتخاب کنید.');return}const replied=rows.filter(r=>r.responded).map(r=>r.person.name),action=automatic?'ارسال':'پیش‌نمایش';let q=`${action} یادآوری برای ${fa(rows.length)} نفر انجام شود؟`;if(replied.length)q+=`\nتوجه: پاسخ این افراد شناسایی شده است: ${replied.join('، ')}`;if(!await alertBox('تأیید یادآوری',q,{confirm:true}))return;busy(true,`در حال ${action} یادآوری‌ها…`);try{const d=await bridge('/followups/run',{rows,template:state.config.templates.followup,automatic});let msg=`${fa((d.sent||[]).length)} یادآوری ${automatic?'ارسال شد':'در اوت‌لوک باز شد'}.`;if((d.failures||[]).length)msg+=`\nخطا: ${fa(d.failures.length)}\n\n${d.failures.slice(0,5).join('\n')}`;await alertBox('یادآوری',msg)}catch(e){await alertBox('ارسال یادآوری',e.message)}finally{busy(false)}}

function setupHeaderFilters(tableId){const table=document.getElementById(tableId);table.querySelectorAll('th[data-col]').forEach((th,idx)=>{th.dataset.index=idx;th.addEventListener('click',e=>{e.stopPropagation();openFilterPopup(tableId,th.dataset.col,idx,th)})})}
function openFilterPopup(tableId,col,idx,anchor){const popup=document.getElementById('filterPopup'),table=document.getElementById(tableId),key=`${tableId}:${col}`,current=state.filters.get(key)||'',vals=[...new Set([...table.tBodies[0].rows].map(r=>norm(r.cells[idx]?.innerText)||'—'))].sort((a,b)=>a.localeCompare(b,'fa'));popup.innerHTML='';const add=(label,val)=>{const d=document.createElement('div');d.className='filter-option';d.textContent=(current===val?'✓   ':'    ')+label;d.onclick=()=>{if(val)state.filters.set(key,val);else state.filters.delete(key);popup.classList.add('hidden');applyTableFilters(tableId)};popup.appendChild(d)};add('نمایش همه','');for(const v of vals)add(v,v);const rect=anchor.getBoundingClientRect();popup.style.top=`${Math.min(rect.bottom+3,innerHeight-430)}px`;popup.style.right=`${Math.max(4,innerWidth-rect.right)}px`;popup.classList.remove('hidden')}
function applyTableFilters(tableId){const table=document.getElementById(tableId),heads=[...table.querySelectorAll('th[data-col]')];heads.forEach((h,i)=>{const key=`${tableId}:${h.dataset.col}`,wanted=state.filters.get(key)||'';h.classList.toggle('filtered',!!wanted);[...table.tBodies[0].rows].forEach(r=>{if(r.dataset.filteredOut==='1')return});});[...table.tBodies[0].rows].forEach(r=>{let show=true;heads.forEach((h,i)=>{const wanted=state.filters.get(`${tableId}:${h.dataset.col}`)||'';if(wanted&&(norm(r.cells[i]?.innerText)||'—')!==wanted)show=false});r.style.display=show?'':'none'})}

function gregorianToJalali(gy,gm,gd){const gdm=[0,31,59,90,120,151,181,212,243,273,304,334];let gy2=gm>2?gy+1:gy,days=355666+365*gy+Math.floor((gy2+3)/4)-Math.floor((gy2+99)/100)+Math.floor((gy2+399)/400)+gd+gdm[gm-1],jy=-1595+33*Math.floor(days/12053);days%=12053;jy+=4*Math.floor(days/1461);days%=1461;if(days>365){jy+=Math.floor((days-1)/365);days=(days-1)%365}let jm,jd;if(days<186){jm=1+Math.floor(days/31);jd=1+days%31}else{jm=7+Math.floor((days-186)/30);jd=1+(days-186)%30}return[jy,jm,jd]}
function jalaliToGregorian(jy,jm,jd){jy+=1595;let days=-355668+365*jy+Math.floor(jy/33)*8+Math.floor((jy%33+3)/4)+jd+(jm<7?(jm-1)*31:(jm-7)*30+186),gy=400*Math.floor(days/146097);days%=146097;if(days>36524){gy+=100*Math.floor(--days/36524);days%=36524;if(days>=365)days++}gy+=4*Math.floor(days/1461);days%=1461;if(days>365){gy+=Math.floor((days-1)/365);days=(days-1)%365}let gd=days+1,sal=[0,31,(gy%4===0&&gy%100!==0)||gy%400===0?29:28,31,30,31,30,31,31,30,31,30,31],gm=1;while(gm<=12&&gd>sal[gm])gd-=sal[gm++];return[gy,gm,gd]}
function jalaliMonthDays(jy,jm){if(jm<=6)return 31;if(jm<=11)return 30;const [gy]=jalaliToGregorian(jy,1,1),[ngy]=jalaliToGregorian(jy+1,1,1);const leap=(Date.UTC(ngy,0,1)-Date.UTC(gy,0,1))/86400000===366;return leap?30:29}
function openCalendar(targetId){state.calendarTarget=targetId;const cur=jalaliTuple(document.getElementById(targetId).value),now=gregorianToJalali(new Date().getFullYear(),new Date().getMonth()+1,new Date().getDate());state.cal.jy=cur?.[0]||now[0];state.cal.jm=cur?.[1]||now[1];renderCalendar();document.getElementById('calendarDialog').showModal()}
function renderCalendar(){const y=document.getElementById('calYear'),m=document.getElementById('calMonth'),months=['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];y.innerHTML=Array.from({length:21},(_,i)=>state.cal.jy-10+i).map(v=>`<option value="${v}">${fa(v)}</option>`).join('');y.value=state.cal.jy;m.innerHTML=months.map((x,i)=>`<option value="${i+1}">${x}</option>`).join('');m.value=state.cal.jm;const [gy,gm,gd]=jalaliToGregorian(state.cal.jy,state.cal.jm,1),dow=(new Date(gy,gm-1,gd).getDay()+1)%7,days=jalaliMonthDays(state.cal.jy,state.cal.jm),grid=document.getElementById('calendarGrid'),today=gregorianToJalali(new Date().getFullYear(),new Date().getMonth()+1,new Date().getDate());grid.innerHTML='';for(let i=0;i<dow;i++){const b=document.createElement('button');b.className='day muted';b.disabled=true;grid.appendChild(b)}for(let d=1;d<=days;d++){const b=document.createElement('button');b.className='day'+(today[0]===state.cal.jy&&today[1]===state.cal.jm&&today[2]===d?' today':'');b.textContent=fa(d);b.onclick=()=>{document.getElementById(state.calendarTarget).value=fa(`${state.cal.jy.toString().padStart(4,'0')}/${String(state.cal.jm).padStart(2,'0')}/${String(d).padStart(2,'0')}`);document.getElementById('calendarDialog').close();if(state.calendarTarget.startsWith('perf'))renderDashboard()};grid.appendChild(b)}}

function wire(){document.getElementById('brandLogo').src=A().header_logo||'bamco-logo.png';document.getElementById('menuToggle').onclick=()=>document.getElementById('sidebar').classList.toggle('collapsed');document.querySelectorAll('.nav-btn').forEach(b=>b.onclick=()=>openView(b.dataset.view));document.getElementById('chooseWorkbook').onclick=chooseWorkbook;document.getElementById('analyzeWorkbook').onclick=analyzeWorkbook;['dashOwner','dashPriority','dashStatus','dashBucket'].forEach(id=>document.getElementById(id).onchange=renderDashboard);document.getElementById('resetDashFilters').onclick=()=>{['dashOwner','dashPriority','dashStatus','dashBucket'].forEach(id=>document.getElementById(id).value='همه');renderDashboard()};document.getElementById('applyPerf').onclick=renderDashboard;document.getElementById('clearPerf').onclick=()=>{document.getElementById('perfFrom').value='';document.getElementById('perfTo').value='';renderDashboard()};document.querySelectorAll('.calendar-btn').forEach(b=>b.onclick=()=>openCalendar(b.dataset.dateTarget));document.getElementById('addPerson').onclick=()=>openPersonDialog();document.getElementById('editPerson').onclick=()=>state.selectedPersonIndex===null?alertBox('ویرایش فرد','ابتدا یک فرد را انتخاب کنید.'):openPersonDialog(state.selectedPersonIndex);document.getElementById('deletePerson').onclick=deletePerson;document.getElementById('personForm').onsubmit=savePersonForm;document.querySelectorAll('[data-select-send]').forEach(b=>b.onclick=()=>selectSend(b.dataset.selectSend));document.getElementById('runReports').onclick=runReports;document.getElementById('editTemplate').onclick=openTemplateDialog;document.getElementById('templateForm').onsubmit=saveTemplateDialog;document.getElementById('resetTemplate').onclick=resetTemplate;document.getElementById('previewTemplate').onclick=previewTemplate;fillStickerControls();document.getElementById('stickerState').onchange=refreshStickerContext;document.querySelectorAll('input[name=stickerGender]').forEach(x=>x.onchange=refreshStickerContext);document.getElementById('activatePack').onclick=activatePack;document.getElementById('restorePack').onclick=restorePack;buildPackMatrix();document.getElementById('newPack').onclick=()=>{document.getElementById('packForm').reset();document.getElementById('packDialog').showModal()};document.getElementById('packForm').onsubmit=savePack;document.getElementById('inspectFollowups').onclick=inspectFollowups;document.getElementById('selectUnanswered').onclick=selectUnanswered;document.getElementById('clearFollowSelection').onclick=()=>{state.followSelected.clear();renderFollowups()};document.getElementById('previewFollowups').onclick=()=>runFo