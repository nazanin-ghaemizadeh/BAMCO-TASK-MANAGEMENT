(()=>{
'use strict';
const A=()=>window.BAMCO_DESKTOP_ASSETS||{};
const DEFAULT_RECIPIENTS=[{"name":"نازنین قائمی","salutation":"سرکار خانم مهندس قائمی","gender":"خانم","email":"ghaemizadeh@bamco.ir","cc":["tanhaiyan@bamco.ir"],"active":true},{"name":"امیرحسین زارع جرجندی","salutation":"جناب آقای مهندس زارع جرجندی","gender":"آقا","email":"a.zare@bamcofactory.ir","cc":["tanhaiyan@bamco.ir"],"active":true},{"name":"رضا احمدی","salutation":"جناب آقای مهندس احمدی","gender":"آقا","email":"r.ahmadi@bamcofactory.ir","cc":["tanhaiyan@bamco.ir","a.zare@bamcofactory.ir"],"active":true},{"name":"پریسا مشکی","salutation":"سرکار خانم مهندس مشکی","gender":"خانم","email":"p.moshki@bamcofactory.ir","cc":["tanhaiyan@bamco.ir","a.zare@bamcofactory.ir"],"active":true},{"name":"سوگند راستی","salutation":"سرکار خانم مهندس راستی","gender":"خانم","email":"rasti@bamco.ir","cc":["tanhaiyan@bamco.ir"],"active":true},{"name":"کامیاب شاه آبادی","salutation":"جناب آقای مهندس شاه آبادی","gender":"آقا","email":"k.shahabadi@bamco.ir","cc":["tanhaiyan@bamco.ir"],"active":true},{"name":"شهاب الدین تنهائیان","salutation":"جناب آقای مهندس تنهائیان","gender":"آقا","email":"tanhaiyan@bamco.ir","cc":["a.zare@bamcofactory.ir"],"active":true},{"name":"دانیال حسین نژاد","salutation":"جناب آقای مهندس حسین نژاد","gender":"آقا","email":"d.hosseinnezhad@bamcofactory.ir","cc":["tanhaiyan@bamco.ir","a.zare@bamcofactory.ir"],"active":true},{"name":"مصطفی چهره","salutation":"جناب آقای مهندس چهره","gender":"آقا","email":"chehreh@bamco.ir","cc":["tanhaiyan@bamco.ir","a.zare@bamcofactory.ir"],"active":true}];
const DEFAULT_TEMPLATES={"state1":{"subject":"گزارش روزانه وضعیت امور | [تاریخ کامل شمسی] | وضعیت مطلوب","body":"[عنوان و نام مخاطب]\n\nبا درود و مهر،\n\nبررسی آخرین اطلاعات ثبت‌شده در فایل «مدیریت وظایف» نشان می‌دهد که در حال حاضر هیچ‌یک از فعالیت‌های حوزه مسئولیت شما در وضعیت «هشدار» یا «دیرکرد» قرار ندارد.\n\nخلاصه وضعیت: ۰ مورد هشداری | ۰ مورد دیرکردی\n\n[استیکر]\n\nاز همراهی و اهتمام شما در پیگیری، انجام به‌موقع و به‌روزرسانی امور سپاسگزاریم.\n\nچنانچه تغییری در آخرین وضعیت فعالیت‌ها ایجاد شده است، لطفاً با پاسخ به همین ایمیل، مراتب را اعلام فرمایید تا اطلاعات فایل «مدیریت وظایف» به‌روزرسانی شود. همچنین در صورت نیاز می‌توانید از طریق شماره داخلی ۷۴۸۸ با مهندس قائمی در ارتباط باشید.\n\nتاریخ گزارش: [تاریخ کامل شمسی]\n\nبا تشکر و احترام\nسامانه خودکار پایش و پیگیری امور\nشرکت خودروسازان بم\nواحد مهندسی محصول"},"state2":{"subject":"گزارش روزانه وضعیت امور | [تاریخ کامل شمسی] | یادآوری","body":"[عنوان و نام مخاطب]\n\nبا درود و مهر،\n\nبررسی آخرین اطلاعات ثبت‌شده در فایل «مدیریت وظایف» نشان می‌دهد که [تعداد امور هشداری] مورد از فعالیت‌های حوزه مسئولیت شما وارد دوره «هشدار» شده‌اند و موعد پایان آن‌ها نزدیک است.\n\nخلاصه وضعیت: [تعداد امور هشداری] مورد هشداری | ۰ مورد دیرکردی\n\n[استیکر]\n\n[جدول امور هشداری]\n\nلطفاً ضمن بررسی موارد فوق، برنامه‌ریزی و پیگیری لازم را به‌منظور انجام آن‌ها پیش از فرارسیدن موعد مقرر در دستور کار قرار دهید.\n\nچنانچه هر یک از فعالیت‌ها انجام شده، پیشرفت داشته یا وضعیت آن تغییر کرده است، لطفاً با پاسخ به همین ایمیل، مراتب را اعلام فرمایید تا اطلاعات فایل «مدیریت وظایف» به‌روزرسانی شود. همچنین در صورت نیاز می‌توانید از طریق شماره داخلی ۷۴۸۸ با مهندس قائمی در ارتباط باشید.\n\nتاریخ گزارش: [تاریخ کامل شمسی]\n\nبا تشکر و احترام\nسامانه خودکار پایش و پیگیری امور\nشرکت خودروسازان بم\nواحد مهندسی محصول"},"state3":{"subject":"گزارش روزانه وضعیت امور | [تاریخ کامل شمسی] | نیازمند توجه","body":"[عنوان و نام مخاطب]\n\nبا درود و مهر،\n\nبررسی آخرین اطلاعات ثبت‌شده در فایل «مدیریت وظایف» نشان می‌دهد که [تعداد امور دیرکردی] مورد از فعالیت‌های حوزه مسئولیت شما از موعد تعیین‌شده عبور کرده و در وضعیت «دیرکرد» قرار گرفته‌اند.\n\nخلاصه وضعیت: [تعداد امور هشداری] مورد هشداری | [تعداد امور دیرکردی] مورد دیرکردی\n\n[استیکر]\n\n[جدول امور دیرکردی]\n\n[جدول امور هشداری]\n\nلطفاً موارد فوق را بررسی کرده و اقدامات لازم برای تکمیل آن‌ها و به‌روزرسانی آخرین وضعیت هر فعالیت را در اسرع وقت انجام دهید.\n\nچنانچه هر یک از فعالیت‌ها انجام شده، پیشرفت داشته یا وضعیت آن تغییر کرده است، لطفاً با پاسخ به همین ایمیل، مراتب را اعلام فرمایید تا اطلاعات فایل «مدیریت وظایف» به‌روزرسانی شود. همچنین در صورت نیاز می‌توانید از طریق شماره داخلی ۷۴۸۸ با مهندس قائمی در ارتباط باشید.\n\nتاریخ گزارش: [تاریخ کامل شمسی]\n\nبا تشکر و احترام\nسامانه خودکار پایش و پیگیری امور\nشرکت خودروسازان بم\nواحد مهندسی محصول"},"state4":{"subject":"گزارش روزانه وضعیت امور | [تاریخ کامل شمسی] | پیگیری جدی","body":"[عنوان و نام مخاطب]\n\nبا درود و مهر،\n\nبررسی آخرین اطلاعات ثبت‌شده در فایل «مدیریت وظایف» نشان می‌دهد که [تعداد امور دیرکردی] مورد از فعالیت‌های حوزه مسئولیت شما در وضعیت «دیرکرد» قرار دارند و نیازمند پیگیری جدی‌تر هستند.\n\nخلاصه وضعیت: [تعداد امور هشداری] مورد هشداری | [تعداد امور دیرکردی] مورد دیرکردی\n\n[استیکر]\n\n[جدول امور دیرکردی]\n\n[جدول امور هشداری]\n\nخواهشمند است موارد فوق با جدیت بررسی شده و اقدامات لازم برای تعیین تکلیف، تکمیل و به‌روزرسانی وضعیت آن‌ها در اولویت قرار گیرد.\n\nچنانچه هر یک از فعالیت‌ها انجام شده، پیشرفت داشته یا وضعیت آن تغییر کرده است، لطفاً با پاسخ به همین ایمیل، مراتب را اعلام فرمایید تا اطلاعات فایل «مدیریت وظایف» به‌روزرسانی شود. همچنین در صورت نیاز می‌توانید از طریق شماره داخلی ۷۴۸۸ با مهندس قائمی در ارتباط باشید.\n\nتاریخ گزارش: [تاریخ کامل شمسی]\n\nبا تشکر و احترام\nسامانه خودکار پایش و پیگیری امور\nشرکت خودروسازان بم\nواحد مهندسی محصول"},"state5":{"subject":"گزارش روزانه وضعیت امور | [تاریخ کامل شمسی] | اقدام فوری","body":"[عنوان و نام مخاطب]\n\nبا درود و مهر،\n\nبررسی آخرین اطلاعات ثبت‌شده در فایل «مدیریت وظایف» نشان می‌دهد که [تعداد امور دیرکردی] مورد از فعالیت‌های حوزه مسئولیت شما در وضعیت «دیرکرد» قرار گرفته‌اند و نیازمند رسیدگی و اقدام فوری هستند.\n\nخلاصه وضعیت: [تعداد امور هشداری] مورد هشداری | [تعداد امور دیرکردی] مورد دیرکردی\n\n[استیکر]\n\n[جدول امور دیرکردی]\n\n[جدول امور هشداری]\n\nخواهشمند است موارد فوق در اولویت پیگیری قرار گرفته و اقدامات مقتضی برای تعیین تکلیف و تکمیل آن‌ها در سریع‌ترین زمان ممکن انجام شود.\n\nچنانچه هر یک از فعالیت‌ها انجام شده، پیشرفت داشته یا وضعیت آن تغییر کرده است، لطفاً با پاسخ به همین ایمیل، مراتب را اعلام فرمایید تا اطلاعات فایل «مدیریت وظایف» به‌روزرسانی شود. همچنین در صورت نیاز می‌توانید از طریق شماره داخلی ۷۴۸۸ با مهندس قائمی در ارتباط باشید.\n\nتاریخ گزارش: [تاریخ کامل شمسی]\n\nبا تشکر و احترام\nسامانه خودکار پایش و پیگیری امور\nشرکت خودروسازان بم\nواحد مهندسی محصول"},"followup":{"subject":"یادآوری مجدد وضعیت امور | [تاریخ کامل شمسی]","body":"[عنوان و نام مخاطب]\n\nبا درود و مهر،\n\nپیرو آخرین گزارش ارسال‌شده درباره وضعیت امور در تاریخ [تاریخ آخرین ارسال]، تاکنون پاسخی از سوی شما دریافت نشده است.\n\nخواهشمند است در صورت انجام فعالیت‌ها، ایجاد پیشرفت یا تغییر در آخرین وضعیت امور، مراتب را از طریق پاسخ به همین ایمیل اعلام فرمایید تا اطلاعات فایل «مدیریت وظایف» به‌روزرسانی شود.\n\nهمچنین در صورت نیاز می‌توانید از طریق شماره داخلی ۷۴۸۸ با مهندس قائمی در ارتباط باشید.\n\nبا تشکر و احترام\nسامانه خودکار پایش و پیگیری امور\nشرکت خودروسازان بم\nواحد مهندسی محصول"}};
const STATE_META={"state1":{"label":"وضعیت مطلوب","sticker":"01_happy"},"state2":{"label":"یادآوری","sticker":"02_reminder"},"state3":{"label":"نیازمند توجه","sticker":"03_concerned"},"state4":{"label":"پیگیری جدی","sticker":"04_serious"},"state5":{"label":"اقدام فوری","sticker":"05_urgent"},"followup":{"label":"یادآوری مجدد","sticker":""}};
const WARNING='دوره هشدار', OVERDUE='دیرکرد';
const PRIORITY_ORDER=['فوری','متوسط','کم','—'];
const CURRENT_STATUSES=['ثبت شده','در حال انجام','منتظر پاسخ','انجام شده'];
const BUCKETS=[OVERDUE,WARNING,'فاقد شرایط دیرکرد','نامشخص'];
const faMap=Object.fromEntries([...Array(10)].map((_,i)=>[String(i),'۰۱۲۳۴۵۶۷۸۹'[i]]));
const enMap=Object.fromEntries([...Array(10)].map((_,i)=>['۰۱۲۳۴۵۶۷۸۹'[i],String(i)]));
const fa=v=>String(v??'').replace(/[0-9]/g,d=>faMap[d]);
const en=v=>String(v??'').replace(/[۰-۹]/g,d=>enMap[d]);
const norm=v=>String(v??'').replaceAll('ي','ی').replaceAll('ك','ک').replace(/[\u200c\u200f\ufeff]/g,' ').replace(/\s+/g,' ').trim();
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const state={config:{send_delay_seconds:10,recipients:structuredClone(DEFAULT_RECIPIENTS),templates:structuredClone(DEFAULT_TEMPLATES)},workbookPath:'',tasks:{},owners:[],dateIssues:[],dashboard:{kanban:[],archive:[]},dashboardIssues:[],selectedPeople:new Set(),selectedPersonIndex:null,followups:[],followSelected:new Set(),filters:new Map(),calendarTarget:null,cal:{jy:1405,jm:1},packFiles:new Map()};

function busy(on,text='در حال پردازش…'){document.getElementById('busy').classList.toggle('hidden',!on);document.getElementById('busyText').textContent=text}
function alertBox(title,body,{confirm=false}={}){return new Promise(resolve=>{const d=document.getElementById('alertDialog'),ok=document.getElementById('alertOk'),cancel=document.getElementById('alertCancel');document.getElementById('alertTitle').textContent=title;document.getElementById('alertBody').textContent=body;cancel.classList.toggle('hidden',!confirm);const close=()=>{const value=d.returnValue;cleanup();resolve(value==='ok')};const cleanup=()=>{d.removeEventListener('close',close)};d.addEventListener('close',close);d.showModal();ok.focus()})}
async function bridge(path,payload=null,method='POST'){
  const opts={method,headers:{'Content-Type':'application/json'}}; if(payload!==null&&method!=='GET')opts.body=JSON.stringify(payload);
  let r; try{r=await fetch(`http://127.0.0.1:8765${path}`,opts)}catch(e){throw new Error('ارتباط با بخش محلی برنامه برقرار نشد. فایل Start_Outlook_Bridge.bat را روی همین رایانه اجرا کنید و Outlook را باز نگه دارید.')}
  const data=await r.json().catch(()=>({})); if(!r.ok||data.ok===false)throw new Error(data.error||'عملیات انجام نشد.'); return data;
}
async function loadConfig(){try{const d=await bridge('/config',null,'GET');state.config=d.config||state.config}catch{} if(!state.config.recipients)state.config.recipients=structuredClone(DEFAULT_RECIPIENTS);if(!state.config.templates)state.config.templates=structuredClone(DEFAULT_TEMPLATES);renderPeople();renderTemplates();renderSend()}
async function saveConfig(){await bridge('/config/save',{config:state.config})}
function openView(name){document.querySelectorAll('.view').forEach(v=>v.classList.remove('active-view'));document.getElementById(`view-${name}`).classList.add('active-view');document.querySelectorAll('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.view===name));if(name==='dashboard')requestAnimationFrame(renderDashboard);if(name==='people')renderPeople();if(name==='send')renderSend();if(name==='stickers')refreshStickerContext();if(name==='followup')renderFollowups()}

async function chooseWorkbook(){busy(true,'در حال باز کردن پنجره انتخاب فایل…');try{const d=await bridge('/workbook/choose',{});if(d.path){state.workbookPath=d.path;document.getElementById('workbookPath').value=d.path}}catch(e){await alertBox('انتخاب فایل',e.message)}finally{busy(false)}}
async function analyzeWorkbook(){const path=state.workbookPath||document.getElementById('workbookPath').value.trim(),password=document.getElementById('workbookPassword').value,sheet=document.getElementById('sheetName').value.trim()||'KANBAN';if(!path){await alertBox('فایل نامعتبر','ابتدا فایل مدیریت وظایف را انتخاب کنید.');return}if(!password){await alertBox('رمز فایل','رمز فایل را وارد کنید.');return}busy(true,'در حال خواندن و بررسی فایل…');try{const d=await bridge('/workbook/analyze',{path,password,sheet_name:sheet});state.tasks=d.tasks||{};state.owners=d.owners||[];state.dateIssues=d.date_issues||[];state.dashboard=d.dashboard||{kanban:[],archive:[]};state.dashboardIssues=d.dashboard_date_issues||[];state.selectedPeople.clear();refreshDashFilterOptions();renderSend();renderDashboard();let msg='فایل با موفقیت خوانده و بررسی شد.';const issues=[...state.dateIssues,...state.dashboardIssues];if(issues.length)msg+=`\n\nهشدارهای تاریخ: ${fa(issues.length)} مورد\n`+issues.slice(0,8).join('\n');await alertBox('بررسی فایل',msg);openView('dashboard')}catch(e){await alertBox('خواندن فایل',e.message)}finally{busy(false)}}

function activePeople(){return (state.config.recipients||[]).filter(p=>p.active)}
function groupFor(name){return state.tasks[norm(name)]||state.tasks[name]||{[WARNING]:[],[OVERDUE]:[]}}
function statusKeyForPerson(p){const g=groupFor(p.name),w=(g[WARNING]||[]).length,o=(g[OVERDUE]||[]).length;if(o>=5)return'state5';if(o>=3)return'state4';if(o>=1)return'state3';if(w>=1)return'state2';return'state1'}
function statusLabel(p){return STATE_META[statusKeyForPerson(p)].label}

function renderPeople(){const body=document.querySelector('#peopleTable tbody');body.innerHTML='';(state.config.recipients||[]).forEach((p,i)=>{const tr=document.createElement('tr');tr.dataset.index=i;if(i===state.selectedPersonIndex)tr.classList.add('selected');tr.innerHTML=`<td class="center-cell">${p.active?'✓':''}</td><td>${esc((p.cc||[]).join('؛ '))}</td><td>${esc(p.salutation||'')}</td><td class="ltr">${esc(p.email||'')}</td><td class="center-cell">${esc(p.gender||'')}</td><td>${esc(p.name||'')}</td>`;tr.onclick=()=>{state.selectedPersonIndex=i;renderPeople()};tr.ondblclick=()=>openPersonDialog(i);body.appendChild(tr)});applyTableFilters('peopleTable')}
function openPersonDialog(index=null){const d=document.getElementById('personDialog'),f=document.getElementById('personForm');f.dataset.index=index===null?'':String(index);const p=index===null?{name:'',salutation:'',gender:'خانم',email:'',cc:[],active:true}:state.config.recipients[index];document.getElementById('personDialogTitle').textContent=index===null?'افزودن فرد':'ویرایش فرد';for(const k of ['name','salutation','gender','email'])f.elements[k].value=p[k]||'';f.elements.cc.value=(p.cc||[]).join('\n');f.elements.active.checked=!!p.active;d.showModal()}
async function savePersonForm(ev){ev.preventDefault();const f=ev.currentTarget,index=f.dataset.index===''?null:Number(f.dataset.index);const person={name:norm(f.elements.name.value),salutation:norm(f.elements.salutation.value),gender:f.elements.gender.value,email:f.elements.email.value.trim(),cc:f.elements.cc.value.split(/[;\n,]+/).map(x=>x.trim()).filter(Boolean),active:f.elements.active.checked};if(!person.name||!person.salutation||!person.email)return; if(index===null)state.config.recipients.push(person);else state.config.recipients[index]=person;try{await saveConfig();document.getElementById('personDialog').close();state.selectedPersonIndex=index===null?state.config.recipients.length-1:index;renderPeople();renderSend()}catch(e){await alertBox('ذخیره فرد',e.message)}}
async function deletePerson(){const i=state.selectedPersonIndex;if(i===null||!state.config.recipients[i]){await alertBox('حذف فرد','ابتدا یک فرد را انتخاب کنید.');return}if(!await alertBox('حذف فرد',`«${state.config.recipients[i].name}» حذف شود؟`,{confirm:true}))return;state.config.recipients.splice(i,1);state.selectedPersonIndex=null;try{await saveConfig();renderPeople();renderSend()}catch(e){await alertBox('حذف فرد',e.message)}}

function renderSend(){const body=document.querySelector('#sendTable tbody'