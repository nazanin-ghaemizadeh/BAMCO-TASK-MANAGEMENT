);body.innerHTML='';activePeople().forEach((p,i)=>{const g=groupFor(p.name),w=(g[WARNING]||[]).length,o=(g[OVERDUE]||[]).length,key=statusKeyForPerson(p),token=p.email||p.name;const tr=document.createElement('tr');tr.dataset.token=token;tr.innerHTML=`<td class="center-cell">${state.selectedPeople.has(token)?'☑':'☐'}</td><td class="center-cell">${fa(key.replace('state',''))}</td><td class="center-cell">${fa(o)}</td><td class="center-cell">${fa(w)}</td><td>${esc(STATE_META[key].label)}</td><td class="ltr">${esc(p.email)}</td><td>${esc(p.name)}</td>`;tr.onclick=()=>{state.selectedPeople.has(token)?state.selectedPeople.delete(token):state.selectedPeople.add(token);renderSend()};body.appendChild(tr)});applyTableFilters('sendTable')}
function selectSend(mode){state.selectedPeople.clear();activePeople().forEach(p=>{const g=groupFor(p.name),w=(g[WARNING]||[]).length,o=(g[OVERDUE]||[]).length,token=p.email||p.name;if(mode==='all'||(mode==='overdue'&&o>0)||(mode==='warning'&&w>0))state.selectedPeople.add(token)});renderSend()}
async function runReports(){const people=activePeople().filter(p=>state.selectedPeople.has(p.email||p.name));if(!people.length){await alertBox('انتخاب فرد','حداقل یک فرد را انتخاب کنید.');return}const automatic=document.querySelector('input[name=sendMode]:checked').value==='send';const action=automatic?'ارسال مستقیم':'پیش‌نمایش در اوت‌لوک';if(!await alertBox('تأیید عملیات',`${action} برای ${fa(people.length)} نفر انجام شود؟`,{confirm:true}))return;busy(true,automatic?'در حال ارسال ایمیل‌ها…':'در حال باز کردن پیش‌نمایش‌ها در Outlook…');try{const d=await bridge('/reports/run',{tasks:state.tasks,people,templates:state.config.templates,automatic,delay_seconds:Number(state.config.send_delay_seconds||10)});let msg=`${fa((d.sent||[]).length)} ایمیل ${automatic?'ارسال شد':'در اوت‌لوک باز شد'}.`;if((d.failures||[]).length)msg+=`\nخطا: ${fa(d.failures.length)}\n\n${d.failures.slice(0,6).join('\n')}`;await alertBox('نتیجه ارسال',msg)}catch(e){await alertBox('ارسال ایمیل',e.message)}finally{busy(false)}}

function renderTemplates(){const s=document.getElementById('templateKey');if(!s)return;const current=s.value||'state1';s.innerHTML=Object.entries(STATE_META).map(([k,v])=>`<option value="${k}">${esc(v.label)}</option>`).join('');s.value=STATE_META[current]?current:'state1'}
function openTemplateDialog(){const key=document.getElementById('templateKey').value,t=state.config.templates[key]||DEFAULT_TEMPLATES[key];document.getElementById('templateDialogTitle').textContent=`ویرایش متن «${STATE_META[key].label}»`;document.getElementById('templateSubject').value=t.subject||'';document.getElementById('templateBody').value=t.body||'';document.getElementById('templateDialog').dataset.key=key;document.getElementById('templateDialog').showModal()}
async function saveTemplateDialog(ev){ev.preventDefault();const d=document.getElementById('templateDialog'),key=d.dataset.key,subject=document.getElementById('templateSubject').value.trim(),body=document.getElementById('templateBody').value;if(!subject||!body){await alertBox('متن ایمیل','موضوع و متن ایمیل نباید خالی باشند.');return}state.config.templates[key]={subject,body};try{await saveConfig();d.close();await alertBox('ویرایش متن','تغییرات موضوع و متن ایمیل ذخیره شد.')}catch(e){await alertBox('ذخیره متن',e.message)}}
async function resetTemplate(){const key=document.getElementById('templateDialog').dataset.key;if(!await alertBox('بازگردانی متن',`موضوع و متن «${STATE_META[key].label}» به نسخه پیش‌فرض بازگردد؟`,{confirm:true}))return;state.config.templates[key]=structuredClone(DEFAULT_TEMPLATES[key]);document.getElementById('templateSubject').value=state.config.templates[key].subject;document.getElementById('templateBody').value=state.config.templates[key].body;await saveConfig()}
async function previewTemplate(){const key=document.getElementById('templateDialog').dataset.key,subject=document.getElementById('templateSubject').value.trim(),body=document.getElementById('templateBody').value;if(!subject||!body){await alertBox('پیش‌نمایش','ابتدا موضوع و متن ایمیل را تکمیل کنید.');return}state.config.templates[key]={subject,body};try{await saveConfig();busy(true,'در حال باز کردن پیش‌نمایش در Outlook…');await bridge('/template/preview',{key,template:state.config.templates[key]})}catch(e){await alertBox('پیش‌نمایش متن',e.message)}finally{busy(false)}}

function jalaliTuple(v){const p=en(v).replace(/[^0-9]+/g,'/').replace(/^\/|\/$/g,'').split('/').filter(Boolean).map(Number);return p.length===3?p:null}
function cmpTuple(a,b){for(let i=0;i<3;i++){if(a[i]!==b[i])return a[i]-b[i]}return 0}
function ownerShortLabel(name){const s=norm(name);if(!s)return'—';const prefixes=['جناب آقای','سرکار خانم','مهندس','آقای','خانم'];let x=s;for(const p of prefixes)if(x.startsWith(p+' '))x=x.slice(p.length+1);return x||s}
function canonicalOwnerName(name,known){const s=ownerShortLabel(name),sn=norm(s);if(!sn)return'—';const exact=known.find(k=>norm(k)===sn);if(exact)return exact;const matches=known.filter(k=>norm(k).includes(sn)||sn.includes(norm(k)));return matches.sort((a,b)=>a.length-b.length)[0]||s}
function refreshDashFilterOptions(){const rows=[...(state.dashboard.kanban||[]),...(state.dashboard.archive||[])];const known=[...new Set(rows.map(r=>ownerShortLabel(r.owner)).filter(x=>x&&x!=='—'))].sort((a,b)=>a.split(' ').length-b.split(' ').length||a.length-b.length||a.localeCompare(b,'fa'));state.dashboardKnownOwners=known;const owners=['همه',...[...new Set(known.map(x=>canonicalOwnerName(x,known)))].sort((a,b)=>a.localeCompare(b,'fa'))];const priorities=['همه',...PRIORITY_ORDER.filter(x=>rows.some(r=>norm(r.priority)===norm(x))),...[...new Set(rows.map(r=>r.priority).filter(x=>x&&!PRIORITY_ORDER.includes(x)&&x!=='—'))].sort()];const k=state.dashboard.kanban||[];const statuses=['همه',...CURRENT_STATUSES.filter(x=>k.some(r=>norm(r.status)===norm(x))),...[...new Set(k.map(r=>r.status).filter(x=>x&&!CURRENT_STATUSES.includes(x)))].sort()];const buckets=['همه',...BUCKETS.filter(x=>k.some(r=>norm(r.due_bucket)===norm(x)))];setOptions('dashOwner',owners);setOptions('dashPriority',priorities);setOptions('dashStatus',statuses);setOptions('dashBucket',buckets)}
function setOptions(id,values){const s=document.getElementById(id),old=s.value||'همه';s.innerHTML=values.map(x=>`<option>${esc(x)}</option>`).join('');s.value=values.includes(old)?old:'همه'}
function filteredDashboard(){let k=[...(state.dashboard.kanban||[])],a=[...(state.dashboard.archive||[])];const owner=document.getElementById('dashOwner').value,priority=document.getElementById('dashPriority').value,status=document.getElementById('dashStatus').value,bucket=document.getElementById('dashBucket').value,known=state.dashboardKnownOwners||[];if(owner!=='همه'){k=k.filter(r=>norm(canonicalOwnerName(r.owner,known))===norm(owner));a=a.filter(r=>norm(canonicalOwnerName(r.owner,known))===norm(owner))}if(priority!=='همه'){k=k.filter(r=>norm(r.priority)===norm(priority));a=a.filter(r=>norm(r.priority)===norm(priority))}if(status!=='همه'){k=k.filter(r=>norm(r.status)===norm(status));a=[]}if(bucket!=='همه'){k=k.filter(r=>norm(r.due_bucket)===norm(bucket));a=[]}return[k,a]}
function renderCards(k,a){const active=k.filter(r=>norm(r.status)!=='انجام شده'),spec=[['archive_total','کل کارهای آرشیو شده',a.length],['warning','در دوره هشدار',active.filter(r=>norm(r.due_bucket)===norm(WARNING)).length],['overdue','دارای دیرکرد',active.filter(r=>norm(r.due_bucket)===norm(OVERDUE)).length],['waiting','منتظر پاسخ',active.filter(r=>norm(r.status)==='منتظر پاسخ').length],['in_progress','در حال انجام',active.filter(r=>norm(r.status)==='در حال انجام').length],['total','کل کارهای فعال',active.length]];document.getElementById('cards').innerHTML=spec.map(([k,l,v])=>`<div class="card" data-key="${k}"><div class="label">${l}</div><div class="value">${fa(v)}</div></div>`).join('')}
function sizeCanvas(c){const dpr=window.devicePixelRatio||1,w=Math.max(600,c.parentElement.clientWidth),h=Number(c.getAttribute('height')||300);if(c.width!==Math.round(w*dpr)||c.height!==Math.round(h*dpr)){c.width=Math.round(w*dpr);c.height=Math.round(h*dpr)}const ctx=c.getContext('2d');ctx.setTransform(dpr,0,0,dpr,0,0);return{ctx,w,h}}
function chartFrame(c,title,subtitle=''){const {ctx,w,h}=sizeCanvas(c);ctx.clearRect(0,0,w,h);ctx.fillStyle='#fff';ctx.fillRect(0,0,w,h);ctx.direction='rtl';ctx.textAlign='right';ctx.fillStyle='#19342b';ctx.font='bold 20px B Nazanin, Tahoma';ctx.fillText(title,w-22,32);if(subtitle){ctx.fillStyle='#71857b';ctx.font='15px B Nazanin, Tahoma';ctx.fillText(subtitle,w-22,57)}return{ctx,w,h}}
function drawEmpty(c,title,msg='داده‌ای برای نمایش وجود ندارد',subtitle=''){const {ctx,w,h}=chartFrame(c,title,subtitle);ctx.textAlign='center';ctx.fillStyle='#879a91';ctx.font='18px B Nazanin, Tahoma';ctx.fillText(msg,w/2,h/2)}
function drawBar(c,title,labels,vals,colors){if(!labels.length)return drawEmpty(c,title);const {ctx,w,h}=chartFrame(c,title);const left=70,right=w-160,top=65,bottom=h-58,max=Math.max(...vals,1);ctx.strokeStyle='#edf2f0';ctx.fillStyle='#879a91';ctx.font='14px B Nazanin, Tahoma';ctx.textAlign='right';for(let i=0;i<=5;i++){const y=bottom-(bottom-top)*i/5;ctx.beginPath();ctx.moveTo(left,y);ctx.lineTo(right,y);ctx.stroke();ctx.fillText(fa(Math.round(max*i/5)),left-8,y+4)}const gap=20,bw=Math.max(32,Math.min(85,((right-left)-gap*(labels.length+1))/labels.length));let x=left+gap;labels.forEach((lab,i)=>{const bh=(bottom-top-10)*vals[i]/max;ctx.fillStyle=colors[i%colors.length];ctx.fillRect(x,bottom-bh,bw,bh);ctx.fillStyle='#435b51';ctx.textAlign='center';ctx.font='bold 15px B Nazanin, Tahoma';ctx.fillText(fa(vals[i]),x+bw/2,bottom-bh-7);ctx.font='14px B Nazanin, Tahoma';ctx.fillText(lab,x+bw/2,bottom+23);x+=bw+gap});ctx.textAlign='right';let ly=80;labels.forEach((lab,i)=>{ctx.fillStyle=colors[i%colors.length];ctx.fillRect(w-130,ly-10,13,13);ctx.fillStyle='#435b51';ctx.fillText(lab,w-140,ly);ly+=26})}
function drawPie(c,title,data,colors){if(!data.length||!data.some(x=>x[1]))return drawEmpty(c,title);const {ctx,w,h}=chartFrame(c,title);const total=data.reduce((s,x)=>s+x[1],0),cx=Math.min(w*.38,360),cy=h*.55,r=Math.min(95,h*.31);let a=-Math.PI/2;data.forEach(([lab,v],i)=>{const d=2*Math.PI*v/total;ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,r,a,a+d);ctx.closePath();ctx.fillStyle=colors[i%colors.length];ctx.fill();const mid=a+d/2,tx=cx+Math.cos(mid)*(r+30),ty=cy+Math.sin(mid)*(r+30);ctx.fillStyle='#435b51';ctx.textAlign='center';ctx.font='bold 14px B Nazanin, Tahoma';ctx.fillText(`${fa(Math.round(v/total*100))}٪`,tx,ty);a+=d});ctx.textAlign='right';let ly=82;data.forEach(([lab],i)=>{ctx.fillStyle=colors[i%colors.length];ctx.fillRect(w-145,ly-10,13,13);ctx.fillStyle='#435b51';ctx.font='15px B Nazanin, Tahoma';ctx.fillText(lab,w-155,ly);ly+=30})}
function drawWorkload(c,rows){const title='حجم کار فعال به تفکیک متولی';if(!rows.length)return drawEmpty(c,title);const {ctx,w,h}=chartFrame(c,title),colors={فوری:'#d1495b',متوسط:'#7b61c8',کم:'#7aa6d1'},segments=['فوری','متوسط','کم'],left=65,right=w-180,top=65,bottom=h-78,max=Math.max(...rows.map(([o,p])=>Object.values(p).reduce((a,b)=>a+b,0)),1),gap=14,bw=Math.max(26,Math.min(65,((right-left)-gap*(rows.length+1))/rows.length));for(let s=0;s<=5;s++){const y=bottom-(bottom-top)*s/5;ctx.strokeStyle='#edf2f0';ctx.beginPath();ctx.moveTo(left,y);ctx.lineTo(right,y);ctx.stroke()}let x=left+gap;for(const [owner,parts] of rows.slice(0,12)){let y=bottom;for(const seg of segments){const v=parts[seg]||0,hv=(bottom-top-10)*v/max;if(v){ctx.fillStyle=colors[seg];ctx.fillRect(x,y-hv,bw,hv);ctx.fillStyle='#222';ctx.textAlign='center';ctx.font='bold 13px B Nazanin, Tahoma';ctx.fillText(fa(v),x+bw/2,y-hv/2+4)}y-=hv}ctx.fillStyle='#435b51';ctx.textAlign='center';ctx.font='13px B Nazanin, Tahoma';ctx.fillText(ownerShortLabel(owner),x+bw/2,bottom+22);x+=bw+gap}ctx.textAlign='right';let ly=82;for(const seg of segments){ctx.fillStyle=colors[seg];ctx.fillRect(w-145,ly-10,13,13);ctx.fillStyle='#435b51';ctx.fillText(seg,w-155,ly);ly+=28}}
function drawPerformance(c,rows,note){const title='عملکرد متولیان';if(!rows.length)return drawEmpty(c,title,note.includes('رکورد')?'در بازه انتخاب‌شده رکورد آرشیو پیدا نشد':'داده‌ای برای نمایش وجود ندارد',note);const {ctx,w,h}=chartFrame(c,title,note),left=62,right=w-170,top=82,bottom=h-88,max=Math.max(...rows.flatMap(x=>[x[1],x[2]]),1),gap=20,gw=Math.max(60,Math.min(104,((right-left)-gap*(rows.length+1))/rows.length)),bw=Math.max(22,Math.min(34,(gw-10)/2));let x=left+gap;for(const [owner,delay,accel] of rows.slice(0,10)){const dh=(bottom-top-10)*delay/max,ah=(bottom-top-10)*accel/max;ctx.fillStyle='#c94f5d';ctx.fillRect(x+4,bottom-dh,bw,dh);ctx.fillStyle='#f0b429';ctx.fillRect(x+12+bw,bottom-ah,bw,ah);ctx.fillStyle='#435b51';ctx.textAlign='center';ctx.font='bold 13px B Nazanin, Tahoma';if(delay)ctx.fillText(fa(Number.isInteger(delay)?delay:delay.toFixed(1)),x+4+bw/2,bottom-dh-7);if(accel)ctx.fillText(fa(Number.isInteger(accel)?accel:accel.toFixed(1)),x+12+bw+bw/2,bottom-ah-7);ctx.font='13px B Nazanin, Tahoma';ctx.fillText(ownerShortLabel(owner),x+gw/2,bottom+22);x+=gw+gap}ctx.textAlign='right';[['تاخیر','#c94f5d'],['تعجیل','#f0b429']].forEach(([l,col],i)=>{ctx.fillStyle=col;ctx.fillRect(w-145,82+i*30-10,13,13);ctx.fillStyle='#435b51';ctx.fillText(l,w-155,82+i*30)})}
function renderDashboard(){if(!document.getElementById('view-dashboard').classList.contains('active-view'))return;const [k,a]=filteredDashboard(),active=k.filter(r=>norm(r.status)!=='انجام شده');renderCards(k,a);let labs=CURRENT_STATUSES.filter(l=>k.some(r=>norm(r.status)===norm(l)));if(!labs.length)labs=[...new Set(k.map(r=>r.status).filter(Boolean))].sort();drawBar(document.getElementById('statusChart'),'وضعیت وظایف جاری',labs,labs.map(l=>k.filter(r=>norm(r.status)===norm(l)).length),['#4f6bed','#2e8b57','#8f63d2','#9aa7b3']);const pls=PRIORITY_ORDER.filter(l=>active.some(r=>norm(r.priority)===norm(l)));drawPie(document.getElementById('priorityChart'),'توزیع کارها بر اساس اولویت',pls.map(l=>[l,active.filter(r=>norm(r.priority)===norm(l)).length]),['#d1495b','#f0b429','#7b61c8','#8b95a1']);const bl=BUCKETS.filter(l=>active.some(r=>norm(r.due_bucket)===norm(l)));drawPie(document.getElementById('bucketChart'),'وضعیت دیرکرد و هشدار',bl.map(l=>[l,active.filter(r=>norm(r.due_bucket)===norm(l)).length]),['#c94f5d','#ee9b00','#7aa6d1','#8b95a1']);const known=state.dashboardKnownOwners||[],owners=[...new Set(active.map(r=>canonicalOwnerName(r.owner,known)).filter(x=>x&&x!=='—'))];const orows=owners.map(o=>{const rs=active.filter(r=>norm(canonicalOwnerName(r.owner,known))===norm(o)),p={فوری:0,کم:0,متوسط:0};for(const r of rs){const q=norm(r.priority);if(q==='فوری')p.فوری++;else if(q==='کم')p.کم++;else p.متوسط++}return[o,p]}).sort((a,b)=>Object.values(b[1]).reduce((x,y)=>x+y,0)-Object.values(a[1]).reduce((x,y)=>x+y,0)||b[1].فوری-a[1].فوری||b[1].متوسط-a[1].متوسط||a[0].localeCompare(b[0],'fa'));drawWorkload(document.getElementById('workloadChart'),orows);renderPerformanceChart