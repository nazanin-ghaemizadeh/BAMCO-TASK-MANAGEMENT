    print("Failed to import BAMCO core:", exc)
    raise


def jsonable(value):
    if isinstance(value, (datetime, date)):
        return value.isoformat()
    if isinstance(value, Path):
        return str(value)
    if isinstance(value, set):
        return [jsonable(x) for x in sorted(value, key=str)]
    if isinstance(value, tuple):
        return [jsonable(x) for x in value]
    if isinstance(value, list):
        return [jsonable(x) for x in value]
    if isinstance(value, dict):
        return {str(k): jsonable(v) for k, v in value.items()}
    return value


def com_start():
    try:
        import pythoncom
    except Exception as exc:
        raise RuntimeError("pywin32 نصب نیست. فایل Setup_Outlook_Bridge.bat را اجرا کنید.") from exc
    pythoncom.CoInitialize()
    return pythoncom


def choose_workbook_native() -> str:
    if os.name != "nt":
        raise RuntimeError("انتخاب فایل بومی فقط در ویندوز در دسترس است.")
    ps = r'''
Add-Type -AssemblyName System.Windows.Forms
$dlg = New-Object System.Windows.Forms.OpenFileDialog
$dlg.Title = 'انتخاب فایل مدیریت وظایف'
$dlg.Filter = 'Excel Macro Workbook (*.xlsm)|*.xlsm|Excel Workbook (*.xlsx)|*.xlsx|All files (*.*)|*.*'
$dlg.Multiselect = $false
if ($dlg.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) { [Console]::OutputEncoding=[Text.Encoding]::UTF8; Write-Output $dlg.FileName }
'''
    flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
    proc = subprocess.run(
        ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-STA", "-Command", ps],
        capture_output=True, text=True, encoding="utf-8", errors="replace", creationflags=flags
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "پنجره انتخاب فایل باز نشد.")
    return proc.stdout.strip().splitlines()[-1].strip() if proc.stdout.strip() else ""


def bootstrap_stickers():
    core.ASSETS_DIR.mkdir(parents=True, exist_ok=True)
    core.DEFAULT_STICKERS_DIR.mkdir(parents=True, exist_ok=True)
    core.STICKER_PACKS_DIR.mkdir(parents=True, exist_ok=True)
    js = BASE / "sticker-default.js"
    if not js.is_file():
        return
    text = js.read_text(encoding="utf-8", errors="ignore")
    matches = re.findall(r"BAMCO_DESKTOP_ASSETS\['([^']+)'\]='data:image/[^;]+;base64,([^']+)'", text)
    if not matches:
        matches = re.findall(r"\['([^']+)'\]\s*=\s*'data:image/[^;]+;base64,([^']+)'", text)
    if not matches:
        return
    try:
        from PIL import Image
    except Exception:
        return
    for key, b64 in matches:
        if not re.match(r"^(?:01_happy|02_reminder|03_concerned|04_serious|05_urgent)_(?:female|male)$", key):
            continue
        default_path = core.DEFAULT_STICKERS_DIR / f"{key}.png"
        active_path = core.ASSETS_DIR / f"{key}.png"
        try:
            if not default_path.is_file():
                image = Image.open(io.BytesIO(base64.b64decode(b64))).convert("RGBA")
                image.thumbnail((1600, 1600), Image.Resampling.LANCZOS)
                image.save(default_path, "PNG", optimize=True)
            if not active_path.is_file():
                shutil.copy2(default_path, active_path)
        except Exception:
            continue


def sticker_pack_map():
    core.STICKER_PACKS_DIR.mkdir(parents=True, exist_ok=True)
    result = {"نسخه اصلی": None}
    for folder in sorted((p for p in core.STICKER_PACKS_DIR.iterdir() if p.is_dir()), key=lambda p: p.name.casefold()):
        title = folder.name.replace("_", " ")
        manifest = folder / "pack.json"
        if manifest.is_file():
            try:
                title = core.normalize(json.loads(manifest.read_text(encoding="utf-8")).get("title")) or title
            except Exception:
                pass
        base, n = title, 2
        while title in result:
            title = f"{base} ({core.to_persian_digits(n)})"
            n += 1
        result[title] = folder
    return result


def restore_all_stickers():
    bootstrap_stickers()
    restored = 0
    for key in ("state1", "state2", "state3", "state4", "state5"):
        for gender in ("خانم", "آقا"):
            target = core.sticker_path_for(key, gender)
            original = core.DEFAULT_STICKERS_DIR / target.name
            if original.is_file():
                shutil.copy2(original, target)
                restored += 1
    if restored != 10:
        raise RuntimeError("نسخه اصلی همه استیکرها پیدا نشد.")


def activate_pack(title: str):
    packs = sticker_pack_map()
    folder = packs.get(title)
    if title == "نسخه اصلی" or folder is None:
        restore_all_stickers()
        return
    missing = []
    for key in ("state1", "state2", "state3", "state4", "state5"):
        for gender in ("خانم", "آقا"):
            name = core.sticker_path_for(key, gender).name
            if not (folder / name).is_file():
                missing.append(name)
    if missing:
        raise RuntimeError("این نسخه کامل نیست و امکان فعال‌سازی آن وجود ندارد.")
    for key in ("state1", "state2", "state3", "state4", "state5"):
        for gender in ("خانم", "آقا"):
            target = core.sticker_path_for(key, gender)
            shutil.copy2(folder / target.name, target)


def save_sticker_pack(title: str, images: dict):
    try:
        from PIL import Image
    except Exception as exc:
        raise RuntimeError("Pillow نصب نیست. فایل Setup_Outlook_Bridge.bat را اجرا کنید.") from exc
    title = core.normalize(title)
    if not title:
        raise RuntimeError("برای نسخه جدید یک نام وارد کنید.")
    required = [(k, g) for g in ("خانم", "آقا") for k in ("state1", "state2", "state3", "state4", "state5")]
    if any(f"{k}|{g}" not in images for k, g in required):
        raise RuntimeError("هر ده تصویر نسخه خانم و آقا باید بارگذاری شوند.")
    safe = re.sub(r'[\\/:*?"<>|]+', " ", title).strip()
    safe = re.sub(r"\s+", "_", safe)[:70] or datetime.now().strftime("pack_%Y%m%d_%H%M%S")
    folder = core.STICKER_PACKS_DIR / safe
    n = 2
    while folder.exists():
        folder = core.STICKER_PACKS_DIR / f"{safe}_{n}"
        n += 1
    folder.mkdir(parents=True, exist_ok=False)
    try:
        for key, gender in required:
            raw = str(images[f"{key}|{gender}"])
            if "," in raw:
                raw = raw.split(",", 1)[1]
            image = Image.open(io.BytesIO(base64.b64decode(raw))).convert("RGBA")
            image.thumbnail((1600, 1600), Image.Resampling.LANCZOS)
            image.save(folder / core.sticker_path_for(key, gender).name, "PNG", optimize=True)
        (folder / "pack.json").write_text(json.dumps({"title": title}, ensure_ascii=False, indent=2), encoding="utf-8")
    except Exception:
        shutil.rmtree(folder, ignore_errors=True)
        raise
    activate_pack(title)


def template_preview(key: str, template: dict):
    pycom = com_start()
    try:
        outlook, _ = core.outlook_app_and_session()
        person = {"name": "همکار گرامی", "salutation": "همکار گرامی", "gender": "آقا", "email": "", "cc": [], "active": True}
        sample = core.empty_group()
        counts = {"state1": (0, 0), "state2": (1, 0), "state3": (1, 2), "state4": (1, 3), "state5": (1, 5), "followup": (0, 0)}[key]
        sample[core.WARNING_STATUS] = [{"title": "نمونه فعالیت در دوره هشدار", "priority": "متوسط", "end": "۱۵ شهریور ۱۴۰۵"} for _ in range(counts[0])]
        sample[core.OVERDUE_STATUS] = [{"title": f"نمونه فعالیت دیرکردی {core.to_persian_digits(i+1)}", "priority": "متوسط", "end": "۵ شهریور ۱۴۰۵"} for i in range(counts[1])]
        extra = {"[تاریخ آخرین ارسال]": "۱۰ شهریور ۱۴۰۵", "[موضوع آخرین ایمیل]": "گزارش روزانه وضعیت امور"}
        mail = outlook.CreateItem(0)
        cid = f"bamco_preview_{key}@local"
        mail.Subject = core.render_subject(template.get("subject", ""), person, sample, core.jalali_full(), extra)
        mail.HTMLBody = apply_template_html_style(core.render_template_body(template.get("body", ""), person, sample, core.jalali_full(), cid if key != "followup" else "", extra), template)
        if key != "followup":
            core.attach_inline(mail, core.sticker_path_for(key, person["gender"]), cid)
        mail.Display()
        force_template_fonts(mail, template)
    finally:
        try:
            pycom.CoUninitialize()
        except Exception:
            pass


def _template_font_size(template: dict):
    font = str((template or {}).get("font_family") or "B Nazanin").strip() or "B Nazanin"
    font = re.sub(r"[\r\n\"'<>]", "", font)[:80] or "B Nazanin"
    try:
        size = int(float((template or {}).get("font_size") or 14))
    except Exception:
        size = 14
    size = min(28, max(8, size))
    return font, size


def apply_template_html_style(html_text: str, template: dict) -> str:
    font, size = _template_font_size(template)
    out = str(html_text or "")
    out = out.replace("'B Nazanin'", f"'{font}'").replace('"B Nazanin"', f'"{font}"')
    out = out.replace('face="B Nazanin"', f'face="{font}"').replace("face='B Nazanin'", f"face='{font}'")
    out = re.sub(r"font-size\s*:\s*14pt", f"font-size:{size}pt", out, flags=re.I)
    return out


def force_template_fonts(item, template: dict) -> None:
    font_name, size = _template_font_size(template)
    try:
        inspector = item.GetInspector
        document = inspector.WordEditor
        font = document.Content.Font
        try:
            font.NameBi = font_name
        except Exception:
            pass
        for attr in ("NameAscii", "NameOther", "NameFarEast"):
            try:
                setattr(font, attr, "Times New Roman")
            except Exception:
                pass
        try:
            font.Size = size
        except Exception:
            pass
    except Exception:
        pass


def run_with_template_styles(template_map: dict, fn):
    template_map = template_map or {}
    original_render = core.render_template_body
    original_force = core.force_outlook_fonts
    current = {"template": {}}

    def find_template(template_text):
        for template in template_map.values():
            if isinstance(template, dict) and str(template.get("body") or "") == str(template_text or ""):
                return template
        return {}

    def styled_render(template_text, *args, **kwargs):
        template = find_template(template_text)
        current["template"] = template
        return apply_template_html_style(original_render(template_text, *args, **kwargs), template)

    def styled_force(item):
        force_template_fonts(item, current.get("template") or {})

    core.render_template_body = styled_render
    core.force_outlook_fonts = styled_force
    try:
        return fn()
    finally:
        core.render_template_body = original_render
        core.force_outlook_fonts = original_force


def save_uploaded_workbook(filename: str, data_url: str) -> str:
    safe = Path(str(filename or "TM.xlsx")).name
    safe = re.sub(r'[^A-Za-z0-9_.\-\u0600-\u06ff ]+', '_', safe)[:160] or 'TM.xlsx'
    raw = str(data_url or '')
    if ',' in raw:
        raw = raw.split(',', 1)[1]
    try:
        data = base64.b64decode(raw, validate=False)
    except Exception as exc:
        raise RuntimeError("فایل انتخاب‌شده قابل خواندن نیست.") from exc
    if not data:
        raise RuntimeError("فایل انتخاب‌شده خالی است.")
    if len(data) > 120 * 1024 * 1024:
        raise RuntimeError("حجم فایل انتخاب‌شده بیش از حد مجاز است.")
    folder = Path(tempfile.gettempdir()) / "BAMCO_TASK_MANAGEMENT_WEB"
    folder.mkdir(parents=True, exist_ok=True)
    target = folder / safe
    target.write_bytes(data)
    return str(target)


def inspect_followups_fast(people, date_from, date_to):
    """Scan sent mail once, then check one latest report per person."""
    _, session = core.outlook_app_and_session()
    targets = {str(p.get("email", "")).strip().lower(): p for p in people if p.get("email")}
    latest = {}
    for folder in core.store_default_folders(session, 5):
        try:
            items = folder.Items
            items.Sort("[SentOn]", True)
            for index in range(1, min(items.Count, 2500) + 1):
                item = items.Item(index)
                if getattr(item, "Class", None) != 43:
                    continue
                sent_on = core.naive_datetime(item.SentOn)
                if sent_on.date() > date_to:
                    continue
                if sent_on.date() < date_from:
                    break
                if core.REPORT_SUBJECT_PREFIX not in str(getattr(item, "Subject", "") or ""):
                    continue
                recipients = core.recipients_of_type(item, 1)
                for email in targets:
                    if email not in latest and any(core.email_identity_matches(address, email) for address in recipients):
                        latest[email] = item
                if len(latest) == len(targets):
                    break
        except Exception:
            continue
    rows = []
    for email, person in targets.items():
        original = latest.get(email)
        if original is None:
            rows.append({"person": person, "found": False, "responded": False})
            continue
        reply = core.find_reply(session, original, person, max_items_per_folder=300)
        sent_on = core.naive_datetime(original.SentOn)
        sent_display = "\u202a" + f"{core.jalali_numeric(sent_on)}   {core.to_persian_digits(sent_on.strftime('%H:%M'))}" + "\u202c"
        rows.append({
            "person": person, "found": True, "responded": reply is not None,
            "entry_id": str(original.EntryID), "store_id": str(original.Parent.StoreID),
            "sent_on": sent_on.isoformat(timespec="seconds"),
            "sent_display": sent_display, "subject": str(original.Subject or ""),
        })
    return rows


class Handler(BaseHTTPRequestHandler):
    server_version = "BAMCOExactBridge/2.0"

    def log_message(self, fmt, *args):
        sys.stdout.write("[BAMCO Bridge] " + fmt % args + "\n")

    def _origin(self):
        return self.headers.get("Origin", "") or "null"

    def _cors(self):
        origin = self._origin()
        if origin in ALLOWED_ORIGINS or origin.startswith("https://nazanin-ghaemizadeh.github.io"):
            self.send_header("Access-Control-Allow-Origin", origin)
        self.send_header("Vary", "Origin")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Access-Control-Allow-Private-Network", "true")
        self.send_header("Access-Control-Max-Age", "600")

    def _json(self, code, obj):
        data = json.dumps(jsonable(obj), ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self._cors()
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _payload(self):
        n = int(self.headers.get("Content-Length", "0") or "0")
        return json.loads(self.rfile.read(n).decode("utf-8") or "{}")

    def do_OPTIONS(self):
        self.send_response(204)
        self._cors()
        self.end_headers()

    def do_GET(self):
        path = urlparse(self.path).path
        try:
            if path == "/health":
                pycom = com_start()
                try:
                    core.outlook_app_and_session()
                finally:
                    pycom.CoUninitialize()
                return self._json(200, {"ok": True, "outlook_open": True})
            if path == "/config":
                return self._json(200, {"ok": True, "config": core.load_config()})
            if path == "/stickers/packs":
                bootstrap_stickers()
                return self._json(200, {"ok": True, "packs": list(sticker_pack_map())})
            return self._json(404, {"ok": False, "error": "not found"})
        except Exception as exc:
            return self._json(503, {"ok": False, "error": str(exc)})

    def do_POST(self):
        path = urlparse(self.path).path
        try:
            payload = self._payload()
            if path == "/workbook/upload":
                return self._json(200, {"ok": True, "path": save_uploaded_workbook(payload.get("filename") or "TM.xlsx", payload.get("data_url") or "")})
            if path == "/workbook/choose":
                return self._json(200, {"ok": True, "path": choose_workbook_native()})
            if path == "/workbook/analyze":
                workbook = Path(str(payload.get("path") or "")).expanduser()
                password = str(payload.get("password") or "")
                sheet = core.normalize(payload.get("sheet_name")) or core.SHEET_NAME_DEFAULT
                if not workbook.is_file():
                    raise RuntimeError("فایل انتخاب‌شده پیدا نشد.")
                tasks, owners, date_issues = core.read_tasks(workbook, password, sheet)
                dashboard, dash_issues = core.read_dashboard_data(workbook, password, sheet, core.load_config().get("dashboard_archive_sheet", "Archive"))
                return self._json(200, {"ok": True, "tasks": tasks, "owners": owners, "date_issues": date_issues, "dashboard": dashboard, "dashboard_date_issues": dash_issues})
            if path == "/config/save":
                incoming = payload.get("config") or {}
                cfg = core.load_config()
                if isinstance(incoming.get("recipients"), list):
                    cfg["recipients"] = incoming["recipients"]
                if isinstance(incoming.get("templates"), dict):
                    cfg["templates"] = incoming["templates"]
                if "send_delay_seconds" in incoming:
                    cfg["send_delay_seconds"] = incoming["send_delay_seconds"]
                core.save_config(cfg)
                return self._json(200, {"ok": True, "config": cfg})
            if path == "/reports/run":
                pycom = com_start()
                try:
                    templates = copy.deepcopy(payload.get("templates") or {})
                    saved_templates = (core.load_config().get("templates") or {})
                    for style_key, style_tpl in templates.items():
                        saved_tpl = saved_templates.get(style_key) or {}
                        if isinstance(style_tpl, dict) and isinstance(saved_tpl, dict):
                            if saved_tpl.get("font_family"):
                                style_tpl["font_family"] = saved_tpl.get("font_family")
                            if saved_tpl.get("font_size"):
                                style_tpl["font_size"] = saved_tpl.get("font_size")
                    sent, skipped, failures = run_with_template_styles(templates, lambda: core.send_reports(
                        payload.get("tasks") or {}, payload.get("people") or [], templates,
                        bool(payload.get("automatic")), True, int(payload.get("delay_seconds") or core.DEFAULT_SEND_DELAY_SECONDS)
                    ))
                finally:
                    pycom.CoUninitialize()
                return self._json(200, {"ok": True, "sent": sent, "skipped": skipped, "failures": failures})
            if path == "/template/preview":
                key = str(payload.get("key") or "state1")
                if key not in core.STATE_META:
                    raise RuntimeError("الگوی ایمیل نامعتبر است.")
                template_preview(key, payload.get("template") or core.DEFAULT_TEMPLATES[key])
                return self._json(200, {"ok": True})
            if path == "/followups/inspect":
                date_from = core.parse_jalali_input(str(payload.get("date_from") or ""))
                date_to = core.parse_jalali_input(str(payload.get("date_to") or ""))
                if not date_from or not date_to:
                    raise RuntimeError("ابتدا بازه زمانی را انتخاب کنید.")
                if date_from > date_to:
                    raise RuntimeError("تاریخ شروع بازه نباید بعد از تاریخ پایان باشد.")
                pycom = com_start()
                try:
                    rows = core.inspect_followups(payload.get("people") or [], date_from, date_to)
                finally:
                    pycom.CoUninitialize()
                return self._json(200, {"ok": True, "rows": rows})
            if path == "/followups/run":
                pycom = com_start()
                try:
                    follow_template = copy.deepcopy(payload.get("template") or core.DEFAULT_TEMPLATES["followup"])
                    saved_follow = (core.load_config().get("templates") or {}).get("followup") or {}
                    if isinstance(saved_follow, dict):
                        if saved_follow.get("font_family"):
                            follow_template["font_family"] = saved_follow.get("font_family")
                        if saved_follow.get("font_size"):
                            follow_template["font_size"] = saved_follow.get("font_size")
                    sent, failures = run_with_template_styles({"followup": follow_template}, lambda: core.send_followup_replies(payload.get("rows") or [], follow_template, bool(payload.get("automatic"))))
